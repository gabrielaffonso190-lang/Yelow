# Obrigatórias para iniciar o bot.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcionais: escopo do deploy, caminho do SQLite e canal MATRIX persistente.
DISCORD_GUILD_ID=
DATABASE_PATH=
MATRIX_CHANNEL_ID=
# Opcionais: provedores de IA configurados no código.
NVIDIA_API_KEY=
NEWS_API_KEY=
HUEHUE_API_KEY=
# Ajustes de IA: timeouts em ms; memória até 40 mensagens; retry entre 0 e 2.
AI_REQUEST_TIMEOUT_MS=18000
AI_FALLBACK_TIMEOUT_MS=14000
AI_HISTORY_MESSAGES=24
AI_RETRY_ATTEMPTS=1
AI_RATE_LIMIT_PER_MINUTE=4
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Ordem dos provedores; Z.PAY é o principal e VoxPay é alternativa opcional.
PAYMENT_PROVIDER=zpay
# Necessárias somente para habilitar cobranças Z.PAY.
ZPAY_CLIENT_ID=
ZPAY_CLIENT_SECRET=
ZPAY_API_URL=https://zpaysolution.com/api/v1
ZPAY_ENVIRONMENT=production
ZPAY_WEBHOOK_SECRET=
ZPAY_WEBHOOK_PORT=8787
# Opcionais: alternativa VoxPay e credencial de webhook, quando configurado.
VOXPAY_API_KEY=
VOXPAY_API_URL=https://voxpaybr.com/api/v1
VOXPAY_WEBHOOK_SECRET=
